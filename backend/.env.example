# ============================================================
# Abonex — configuration serveur de production
# Copier en `.env` et remplir. Ne JAMAIS committer le .env.
# ============================================================

# --- Django ---
DJANGO_DEBUG=false
# Obligatoire en prod : python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=remplacez-par-une-cle-secrete-longue-et-aleatoire
DJANGO_ALLOWED_HOSTS=api.votre-domaine.com,VOTRE_IP_VPS
CORS_ALLOWED_ORIGINS=https://votre-domaine.com
CSRF_TRUSTED_ORIGINS=https://api.votre-domaine.com
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000

# --- Base de données (PostgreSQL via docker-compose) ---
POSTGRES_DB=abonex
POSTGRES_USER=abonex
POSTGRES_PASSWORD=remplacez-par-un-mot-de-passe-long-et-aleatoire

# --- Chiffrement des identifiants/tokens fournisseurs (Fernet) ---
# Obligatoire en prod : python -c "import secrets; print(secrets.token_urlsafe(50))"
# Si absent, dérivé de DJANGO_SECRET_KEY (accepté mais déconseillé).
PROVIDER_SECRET_KEY=remplacez-par-une-cle-dediee-longue-et-aleatoire

# --- Powens (agrégation bancaire PSD2) ---
# Créer une application sur https://console.powens.com
# Enregistrer la redirection : abonex://powens/callback
# Sandbox/dev : POWENS_DOMAIN=sandbox.biapi.pro
# Production  : POWENS_DOMAIN=<votre-domaine-client>.biapi.pro
POWENS_CLIENT_ID=
POWENS_CLIENT_SECRET=
POWENS_DOMAIN=sandbox.biapi.pro
# Optionnel — surcharge complète de l'URL d'API si besoin :
# POWENS_BASE=https://<domaine>.biapi.pro/2.0
# POWENS_REDIRECT_URI=abonex://powens/callback

# --- Mise à jour de l'app (bouton dans Profil) ---
# Version publiée comparée à celle installée + lien de téléchargement.
APP_LATEST_VERSION=1.0.0
APP_UPDATE_URL=https://votre-domaine.com/abonex-latest.apk

# --- E-mail (invitations) — optionnel, sinon sortie console ---
# EMAIL_HOST=smtp.votre-fournisseur.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=

# --- Taux de change — API Forex interne (optionnel, sinon repli public) ---
RATES_CONVERT_URL=https://api-forexplatform.sendbid.app/api/v1/convert/
RATES_API_USER=
RATES_API_PASSWORD=
RATES_API_KEY=

DEMO_SEED_ENABLED=false
DEMO_SEED_PASSWORD=
